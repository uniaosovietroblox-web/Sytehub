        frame.Size = UDim2.new(1, -6, 0, 38)
        frame.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
        frame.Parent = ContentContainer

        Instance.new("UICorner", frame).CornerRadius = UDim.new(0, 6)

