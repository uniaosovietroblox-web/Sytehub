-- ==============================================================================
-- 4. ANTI-LAG & FPS BOOSTER ENGINE
-- ==============================================================================
local AntiLagEngine = {}

function AntiLagEngine:Enable()
    SyteHubConfig.Performance.AntiLagActive = true
    
    -- Otimização de iluminação global
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    Lighting.Brightness = 1
    
    -- Limpeza de efeitos visuais e texturas pesadas
    for _, v in ipairs(Workspace:GetDescendants()) do
        if v:IsA("BasePart") then
            v.Material = Enum.Material.Plastic
            v.Reflectance = 0
        elseif v:IsA("Decal") or v:IsA("Texture") then
            v:Destroy()
        elseif v:IsA("ParticleEmitter") or v:IsA("Trail") or v:IsA("Smoke") or v:IsA("Fire") or v:IsA("Sparkles") then
            v.Enabled = false
        end
    end
    
    -- Desabilita efeitos na iluminação
    for _, effect in ipairs(Lighting:GetChildren()) do
        if effect:IsA("PostEffect") or effect:IsA("BloomEffect") or effect:IsA("BlurEffect") or effect:IsA("SunRaysEffect") then
            effect.Enabled = false
        end
    end
end

-- ==============================================================================
-- 5. AUTO FARM ENGINE (TARGET LOCK & POSITIONING)
-- ==============================================================================
local AutoFarmEngine = {}

function AutoFarmEngine:GetClosestTarget()
    local closestTarget = nil
    local shortestDistance = math.huge
    local char = LocalPlayer.Character
    if not char or not char:FindFirstChild("HumanoidRootPart") then return nil end
    local myPos = char.HumanoidRootPart.Position

    -- Procura por Inimigos / NPCs no Workspace
    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Humanoid") and obj.Health > 0 and obj.Parent ~= char then
            local targetHRP = obj.Parent:FindFirstChild("HumanoidRootPart") or obj.Parent:FindFirstChild("Head")
            if targetHRP then
                local dist = (targetHRP.Position - myPos).Magnitude
                if dist < shortestDistance then
                    shortestDistance = dist
                    closestTarget = targetHRP
                end
            end
        end
    end
    return closestTarget
end

ConnectionManager:Bind("AutoFarmLoop", RunService.Heartbeat:Connect(function()
    if SyteHubConfig.AutoFarm.Enabled then
        local char = LocalPlayer.Character
        if char and char:FindFirstChild("HumanoidRootPart") then
            local target = AutoFarmEngine:GetClosestTarget()
            if target then
                -- Posiciona o jogador com segurança atrás do alvo
                local farmCFrame = target.CFrame * CFrame.new(0, 0, SyteHubConfig.AutoFarm.Distance)
                char:PivotTo(farmCFrame)
                
                -- Ataca automaticamente se houver ferramenta equipada
                local tool = char:FindFirstChildOfClass("Tool")
                if tool then
                    tool:Activate()
                end
            end
        end
    end
end))

