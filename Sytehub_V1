-- 7. MOVEMENT ENGINE (FLY & NOCLIP)
-- ==============================================================================
local MovementEngine = {}

function MovementEngine:SetFly(state: boolean)
    SyteHubConfig.Movement.FlyEnabled = state
    local char = LocalPlayer.Character
    if not char then return end

    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    if state then
        humanoid.PlatformStand = true
        local attachment = hrp:FindFirstChild("SytéFlyAttach") or Instance.new("Attachment", hrp)
        attachment.Name = "SytéFlyAttach"

        local linearVel = Instance.new("LinearVelocity", hrp)
        linearVel.Name = "SytéLinearVelocity"
        linearVel.Attachment0 = attachment
        linearVel.MaxForce = math.huge
        linearVel.VectorVelocity = Vector3.zero
        linearVel.RelativeTo = Enum.ActuatorRelativeTo.World

        local alignOrient = Instance.new("AlignOrientation", hrp)
        alignOrient.Name = "SytéAlignOrient"
        alignOrient.Attachment0 = attachment
        alignOrient.MaxTorque = math.huge
        alignOrient.Responsiveness = 200
        alignOrient.Mode = Enum.OrientationAlignmentMode.OneAttachment

        ConnectionManager:Bind("FlyPhysics", RunService.Heartbeat:Connect(function()
            if not SyteHubConfig.Movement.FlyEnabled or not char:FindFirstChild("HumanoidRootPart") then
                MovementEngine:SetFly(false)
                return
            end
            linearVel.VectorVelocity = Camera.CFrame.LookVector * SyteHubConfig.Movement.FlySpeed
            alignOrient.CFrame = Camera.CFrame
        end))
    else
        humanoid.PlatformStand = false
        ConnectionManager:Unbind("FlyPhysics")
        if hrp:FindFirstChild("SytéLinearVelocity") then hrp.SytéLinearVelocity:Destroy() end
        if hrp:FindFirstChild("SytéAlignOrient") then hrp.SytéAlignOrient:Destroy() end
        if hrp:FindFirstChild("SytéFlyAttach") then hrp.SytéFlyAttach:Destroy() end
    end
end

ConnectionManager:Bind("NoclipLoop", RunService.Stepped:Connect(function()
    if SyteHubConfig.Movement.Noclip and LocalPlayer.Character then
        for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end
end))

