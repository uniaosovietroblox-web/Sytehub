function CombatEngine:GetClosestTarget()
    local closestPart = nil
    local shortestDistance = SyteHubConfig.Combat.FOV
    local viewportCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not (SyteHubConfig.Combat.TeamCheck and player.Team == LocalPlayer.Team) then
                local character = player.Character
                local targetPart = character:FindFirstChild(SyteHubConfig.Combat.TargetPart)
                local humanoid = character:FindFirstChildOfClass("Humanoid")

                if targetPart and humanoid and humanoid.Health > 0 then
                    local screenPos, onScreen = Camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local isVisible = true
                        if SyteHubConfig.Combat.WallCheck then
                            local rayParams = RaycastParams.new()
                            rayParams.FilterType = RaycastFilterType.Exclude
                            rayParams.FilterDescendantsInstances = {LocalPlayer.Character, character}
                            
                            local rayResult = Workspace:Raycast(Camera.CFrame.Position, targetPart.Position - Camera.CFrame.Position, rayParams)
                            if rayResult then isVisible = false end
                        end

                        if isVisible then
                            local screenVector = Vector2.new(screenPos.X, screenPos.Y)
                            local magnitude = (screenVector - viewportCenter).Magnitude
                            if magnitude < shortestDistance then
                                shortestDistance = magnitude
                                closestPart = targetPart
                            end
                        end
                    end
                end
            end
        end
    end
    return closestPart
end

ConnectionManager:Bind("CombatLoop", RunService.RenderStepped:Connect(function()
    if FOVFrame then
        FOVFrame.Visible = SyteHubConfig.Combat.AimbotEnabled
        FOVFrame.Size = UDim2.new(0, SyteHubConfig.Combat.FOV * 2, 0, SyteHubConfig.Combat.FOV * 2)
    end

    if SyteHubConfig.Combat.AimbotEnabled then
        local targetPart = CombatEngine:GetClosestTarget()
        if targetPart then
            local targetPosition = targetPart.Position
            if SyteHubConfig.Combat.Prediction and targetPart.Parent:FindFirstChild("HumanoidRootPart") then
                local velocity = targetPart.Parent.HumanoidRootPart.AssemblyLinearVelocity
                targetPosition = targetPosition + (velocity * SyteHubConfig.Combat.PredictionVelocity)
            end

            local currentCFrame = Camera.CFrame
            local targetCFrame = CFrame.new(currentCFrame.Position, targetPosition)
            Camera.CFrame = currentCFrame:Lerp(targetCFrame, SyteHubConfig.Combat.Smoothness)
        end
    end
end))

