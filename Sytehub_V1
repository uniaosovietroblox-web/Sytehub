local function setupSilentAim()
    local mouse = player:GetMouse()
    if mouse then
        originalMouseButton1Down = mouse.Button1Down
    end
    
    if silentAimConn then silentAimConn:Disconnect(); silentAimConn = nil end
    
    silentAimConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if crosshair.enabled and crosshair.silentAim then
                local target = getTargetUnderCrosshair()
                if target then
                    print("🎯 Silent Aim: alvo - " .. target.Name)
                    fireShot(target)
                    return
                end
            end
            if originalMouseButton1Down then
                originalMouseButton1Down(input)
            end
        end
    end)
end

