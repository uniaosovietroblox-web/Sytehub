-- ===== CRIA O CROSSHAIR (MIRA MÓVEL) =====
local function createCrosshair()
    if crosshairGui then crosshairGui:Destroy() end
    
    crosshairGui = Instance.new("ScreenGui")
    crosshairGui.Name = "Syte_Crosshair"
    crosshairGui.ResetOnSpawn = false
    crosshairGui.IgnoreGuiInset = true
    crosshairGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    pcall(function()
        if gethui then
            crosshairGui.Parent = gethui()
        else
            crosshairGui.Parent = CoreGui
        end
    end)
    if not crosshairGui.Parent then
        crosshairGui.Parent = player:WaitForChild("PlayerGui")
    end
    crosshairGui.Enabled = false

    crosshairFrame = Instance.new("Frame")
    crosshairFrame.Size = UDim2.new(0, 60, 0, 60)
    crosshairFrame.Position = UDim2.new(crosshair.x - 0.03, 0, crosshair.y - 0.03, 0)
    crosshairFrame.BackgroundTransparency = 1
    crosshairFrame.Parent = crosshairGui
    crosshairFrame.Active = true
    crosshairFrame.Draggable = false
    crosshairFrame.ZIndex = 10

    local hLine = Instance.new("Frame")
    hLine.Size = UDim2.new(0, crosshair.size, 0, crosshair.thickness)
    hLine.Position = UDim2.new(0.5, -crosshair.size/2, 0.5, -crosshair.thickness/2)
    hLine.BackgroundColor3 = crosshair.color
    hLine.BorderSizePixel = 0
    hLine.BackgroundTransparency = 0.2
    hLine.Parent = crosshairFrame
    hLine.ZIndex = 11

    local vLine = Instance.new("Frame")
    vLine.Size = UDim2.new(0, crosshair.thickness, 0, crosshair.size)
    vLine.Position = UDim2.new(0.5, -crosshair.thickness/2, 0.5, -crosshair.size/2)
    vLine.BackgroundColor3 = crosshair.color
    vLine.BorderSizePixel = 0
    vLine.BackgroundTransparency = 0.2
    vLine.Parent = crosshairFrame
    vLine.ZIndex = 11

    local dot = Instance.new("Frame")
    dot.Size = UDim2.new(0, 4, 0, 4)
    dot.Position = UDim2.new(0.5, -2, 0.5, -2)
    dot.BackgroundColor3 = crosshair.color
    dot.BorderSizePixel = 0
    dot.BackgroundTransparency = 0.3
    dot.Parent = crosshairFrame
    dot.ZIndex = 12
    Instance.new("UICorner", dot).CornerRadius = UDim.new(0, 2)

    hitboxCircle = Instance.new("Frame")
    hitboxCircle.Size = UDim2.new(0, crosshair.hitboxRadius * 2, 0, crosshair.hitboxRadius * 2)
    hitboxCircle.Position = UDim2.new(0.5, -crosshair.hitboxRadius, 0.5, -crosshair.hitboxRadius)
    hitboxCircle.BackgroundColor3 = crosshair.color
    hitboxCircle.BackgroundTransparency = 0.85
    hitboxCircle.BorderSizePixel = 1
    hitboxCircle.BorderColor3 = crosshair.color
    hitboxCircle.Parent = crosshairFrame
    hitboxCircle.ZIndex = 9
    Instance.new("UICorner", hitboxCircle).CornerRadius = UDim.new(0, crosshair.hitboxRadius)
    hitboxCircle.Visible = crosshair.showHitbox

    local function startDrag(input)
        isDraggingCrosshair = true
        local startPos = input.Position
        local framePos = crosshairFrame.Position
        
        local dragConn
        dragConn = UserInputService.InputChanged:Connect(function(input2)
            if input2.UserInputType == Enum.UserInputType.MouseMovement or input2.UserInputType == Enum.UserInputType.Touch then
                if isDraggingCrosshair then
                    local delta = input2.Position - startPos
                    local newX = framePos.X.Scale + (delta.X / crosshairGui.AbsoluteSize.X)
                    local newY = framePos.Y.Scale + (delta.Y / crosshairGui.AbsoluteSize.Y)
                    newX = math.clamp(newX, 0, 1 - 0.06)
                    newY = math.clamp(newY, 0, 1 - 0.06)
                    crosshairFrame.Position = UDim2.new(newX, 0, newY, 0)
                    crosshair.x = newX + 0.03
                    crosshair.y = newY + 0.03
                end
            end
        end)
        
        local endConn
        endConn = UserInputService.InputEnded:Connect(function(input2)
            if input2 == input then
                isDraggingCrosshair = false
                dragConn:Disconnect()
                endConn:Disconnect()
            end
        end)
    end

    crosshairFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            startDrag(input)
        end
    end)

    crosshairGui.Enabled = true
end

local function updateCrosshair()
    if not crosshairGui or not crosshairFrame then return end
    for _, child in ipairs(crosshairFrame:GetChildren()) do
        if child:IsA("Frame") and child ~= hitboxCircle then
            child.BackgroundColor3 = crosshair.color
        end
    end
    if hitboxCircle then
        hitboxCircle.BackgroundColor3 = crosshair.color
        hitboxCircle.BorderColor3 = crosshair.color
        hitboxCircle.Size = UDim2.new(0, crosshair.hitboxRadius * 2, 0, crosshair.hitboxRadius * 2)
        hitboxCircle.Position = UDim2.new(0.5, -crosshair.hitboxRadius, 0.5, -crosshair.hitboxRadius)
        hitboxCircle.Visible = crosshair.showHitbox
    end
    for _, child in ipairs(crosshairFrame:GetChildren()) do
        if child:IsA("Frame") and child ~= hitboxCircle and child.Size.X.Offset == crosshair.size then
            child.Size = UDim2.new(0, crosshair.size, 0, crosshair.thickness)
            child.Position = UDim2.new(0.5, -crosshair.size/2, 0.5, -crosshair.thickness/2)
        elseif child:IsA("Frame") and child ~= hitboxCircle and child.Size.Y.Offset == crosshair.size then
            child.Size = UDim2.new(0, crosshair.thickness, 0, crosshair.size)
            child.Position = UDim2.new(0.5, -crosshair.thickness/2, 0.5, -crosshair.size/2)
        end
    end
end

-- ===== DETECTA ALVO SOB O CROSSHAIR =====
local function getTargetUnderCrosshair()
    if not crosshairGui or not crosshairFrame then return nil end
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    
    local viewportSize = cam.ViewportSize
    local crosshairPos = Vector2.new(
        crosshair.x * viewportSize.X,
        crosshair.y * viewportSize.Y
    )
    
    local closest = nil
    local closestDist = math.huge
    local myPos = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myPos then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= player and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            if not isEnemy(plr) then continue end
            local root = plr.Character.HumanoidRootPart
            local head = plr.Character:FindFirstChild("Head")
            local targetPos = root.Position
            
            local offset
            if aimbot.useAutoOffset then
                offset = getAutoOffset()
            else
                offset = Vector3.new(aimbot.offsetX, aimbot.offsetY, aimbot.offsetZ)
            end
            targetPos = targetPos + offset
            
            local parts = {}
            if head then parts[#parts+1] = head end
            parts[#parts+1] = root
            if plr.Character:FindFirstChild("UpperTorso") then parts[#parts+1] = plr.Character.UpperTorso end
            if plr.Character:FindFirstChild("LowerTorso") then parts[#parts+1] = plr.Character.LowerTorso end
            
            for _, part in ipairs(parts) do
                if part and part:IsA("BasePart") then
                    local screenPos, onScreen = cam:WorldToScreenPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(screenPos.X, screenPos.Y) - crosshairPos).Magnitude
                        if dist < crosshair.hitboxRadius and dist < closestDist then
                            closestDist = dist
                            closest = plr
                        end
                    end
                end
            end
        end
    end
    return closest
end

-- ===== SIMULA UM TIRO COMPLETO =====
local function fireShot(target)
    if not target or not target.Character then return end
    local targetHumanoid = target.Character:FindFirstChild("Humanoid")
    if not targetHumanoid then return end
    
    local char = player.Character
    if not char then return end
    
    -- 1. Simula clique do mouse (ativa animações, sons, etc.)
    local mouse = player:GetMouse()
    if mouse then
        pcall(function()
            if mouse.Button1Down then
                mouse.Button1Down()
            end
        end)
    end
    
    -- 2. Tenta ativar a ferramenta diretamente
    local tool = char:FindFirstChildOfClass("Tool")
    if tool then
        pcall(function()
            if tool.Activated then
                tool:Activated()
            end
        end)
    end
    
    -- 3. Aplica dano diretamente (para garantir)
    pcall(function()
        targetHumanoid:TakeDamage(crosshair.damageAmount)
    end)
    
    -- 4. Tenta RemoteEvents
    if tool then
        pcall(function()
            if tool:FindFirstChild("RemoteEvent") then
                tool.RemoteEvent:FireServer(targetHumanoid)
            end
            if tool:FindFirstChild("Handle") and tool.Handle:FindFirstChild("RemoteEvent") then
                tool.Handle.RemoteEvent:FireServer(targetHumanoid)
            end
        end)
    end
end

