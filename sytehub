-- VERIFICADOR DE ADMINS / ESP
local function DetectarAdmins()
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer then
            if game.CreatorType == Enum.CreatorType.User and p.UserId == game.CreatorId then return true end
            local isStaff = false
            pcall(function()
                if game.CreatorType == Enum.CreatorType.Group and p:GetRankInGroup(game.CreatorId) >= 100 then
                    isStaff = true
                end
            end)
            if isStaff then return true end
            if p.Character and p.Character:FindFirstChild("Head") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Head") then
                if (p.Character.Head.Position - LocalPlayer.Character.Head.Position).Magnitude < 18 then return true end
            end
        end
    end
    return false
end

