local function SalvarNoDisco()
    if writefile then
        local dadosParaSalvar = { Slots = {} }
        for k, v in pairs(DadosSalvos.Slots) do
            dadosParaSalvar.Slots[k] = {
                Nome = v.Nome,
                CFrame = v.CFrame and {v.CFrame:GetComponents()} or nil
            }
        end
        writefile(ARQUIVO_DADOS, HttpService:JSONEncode(dadosParaSalvar))
    end
end

local function CarregarDoDisco()
    if readfile and isfile and isfile(ARQUIVO_DADOS) then
        pcall(function()
            local dadosCodificados = HttpService:JSONDecode(readfile(ARQUIVO_DADOS))
            for k, v in pairs(dadosCodificados.Slots) do
                if v.CFrame then
                    DadosSalvos.Slots[k].CFrame = CFrame.new(unpack(v.CFrame))
                end
                if v.Nome then
                    DadosSalvos.Slots[k].Nome = v.Nome
                end
            end
        end)
    end
end
