    BotaoTeleporte.TextColor3 = Color3.fromRGB(255, 255, 255)
    BotaoTeleporte.Font = Enum.Font.GothamBold
    BotaoTeleporte.Parent = SlotFrame
    Instance.new("UICorner", BotaoTeleporte).CornerRadius = UDim.new(0, 6)

    BotaoSalvar.MouseButton1Click:Connect(function()
        local char = LocalPlayer.Character
        if char and char.PrimaryPart then
            DadosSalvos.Slots[chaveSlot].CFrame = char:GetPivot()
            SalvarNoDisco()
            StatusLabel.Text = "● Gravado"
            StatusLabel.TextColor3 = Color3.fromRGB(45, 200, 80)
            BotaoSalvar.Text = "Salvo!"
            task.wait(1)
            BotaoSalvar.Text = "Salvar Pos"
        end
    end)

    BotaoTeleporte.MouseButton1Click:Connect(function()
        local pos = DadosSalvos.Slots[chaveSlot].CFrame
