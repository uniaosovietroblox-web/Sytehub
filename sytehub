    SlotFrame.Parent = MainFrame
    Instance.new("UICorner", SlotFrame).CornerRadius = UDim.new(0, 8)

    -- Campo de Nome Editável
    local NameInput = Instance.new("TextBox")
    NameInput.Size = UDim2.new(0, 95, 0, 25)
    NameInput.Position = UDim2.new(0, 10, 0, 6)
    NameInput.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    NameInput.Text = DadosSalvos.Slots[chaveSlot].Nome
    NameInput.TextColor3 = Color3.fromRGB(255, 255, 255)
    NameInput.Font = Enum.Font.GothamSemibold
    NameInput.TextSize = 13
    NameInput.ClearTextOnFocus = false
    NameInput.Parent = SlotFrame
    Instance.new("UICorner", NameInput).CornerRadius = UDim.new(0, 5)

    NameInput.FocusLost:Connect(function()
        DadosSalvos.Slots[chaveSlot].Nome = NameInput.Text
