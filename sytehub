-- SISTEMA DE PERSISTÊNCIA (AUTO-SAVE EM JSON)
local DadosSalvos = {
    Slots = {
        Slot1 = { CFrame = nil, Nome = "Lugar 1" },
        Slot2 = { CFrame = nil, Nome = "Lugar 2" },
        Slot3 = { CFrame = nil, Nome = "Lugar 3" }
